#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  puts "== Installing dependencies =="
  system! "gem install bundler --conservative"
  system("bundle check") || system!("bundle install")

  puts "\n== Cleaning logs and temp files =="
  system! "bin/rails log:clear tmp:clear"

  puts "\n== Verifying Rails boots =="
  system! "bin/rails runner 'puts \"Rails booted successfully\"'"

  puts "\n== Running test suite =="
  system! "bundle exec rspec"

  puts "\n✅ Setup complete"
  puts "Run the application with:"
  puts "  bin/rails server"
  puts "Then visit http://localhost:3000"
end